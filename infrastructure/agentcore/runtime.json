{
  "name": "CanISayYes",
  "architecture": "ARM64",
  "containerPort": 8080,
  "healthCheck": {
    "path": "/ping",
    "intervalSeconds": 30,
    "timeoutSeconds": 5
  },
  "observability": {
    "traces": true,
    "logs": true,
    "toolEvents": true
  },
  "environment": [
    "AWS_REGION",
    "CISAY_BEDROCK_MODEL",
    "CISAY_RECORDED",
    "CISAY_AGENTCORE_SELF"
  ]
}
